{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["jest", "node"],
    "strict": true
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["node_modules", "android", "ios", "babel.config.js", "metro.config.js", "jest.config.js", "tmp"]
}
