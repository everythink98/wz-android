{
  "name": "wz-android",
  "version": "1.3.119",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-video",
          "expo-image"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "postinstall": "patch-package",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:architecture": "node --test tests/tooling/check-architecture.test.mjs",
    "test:ui": "jest --config jest.config.cjs --runInBand",
    "test:device": "node scripts/run-device-replay.mjs",
    "test:device:logged-out": "node scripts/run-logged-out-device-replay.mjs",
    "test:docs": "node --test scripts/check-docs.test.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:react": "npx --yes react-doctor@0.9.3 . --no-warnings --no-telemetry --no-dead-code --no-supply-chain --blocking error",
    "check:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters --allowUnreachableCode false --allowUnusedLabels false",
    "verify": "npm run lint && npm run format:check && npm run check:architecture && npm run test:architecture && npm test && npm run test:ui && npm run test:docs && npm run check:docs && npm run typecheck && npm run check:unused && node scripts/check-version.mjs",
    "android": "expo run:android",
    "release:android": "node scripts/release-android.mjs",
    "smoke:android": "node scripts/smoke-android.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "@shopify/flash-list": "^2.3.1",
    "@tanstack/react-query": "5.101.2",
    "anser": "^2.3.5",
    "buffer": "^6.0.3",
    "expo": "~54.0.33",
    "expo-background-task": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "fast-xml-parser": "^5.8.0",
    "lucide-react-native": "^1.16.0",
    "markdown-it": "14.3.0",
    "node-html-parser": "^7.1.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-pager-view": "6.9.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-render-html": "6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-tab-view": "^4.3.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-zoom-toolkit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.5",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "jsdom": "^25.0.1",
    "patch-package": "8.0.1",
    "prettier": "^3.9.6",
    "test-renderer": "1.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
