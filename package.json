{
  "name": "wz-android",
  "version": "1.3.134",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "main": "index.ts",
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage",
        "@react-native-community/datetimepicker",
        "@react-native-community/slider",
        "@shopify/flash-list",
        "react-native-gesture-handler",
        "react-native-pager-view",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-svg",
        "react-native-webview",
        "react-native-worklets"
      ]
    },
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-video",
          "expo-image"
        ]
      }
    }
  },
  "scripts": {
    "build:composer": "node scripts/build-composer-editor.mjs",
    "prestart": "npm run build:composer",
    "start": "expo start --dev-client",
    "visual:gallery": "node scripts/start-visual-gallery.mjs",
    "postinstall": "patch-package && npm run build:composer",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,mts,js,mjs,cjs,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,js,mjs,cjs,json,yml,yaml}\"",
    "test": "vitest run --sequence.shuffle",
    "test:watch": "vitest",
    "test:architecture": "node --test tests/tooling/check-architecture.test.mjs tests/tooling/visual-gallery-guard.test.mjs",
    "pretest:ui": "npm run build:composer",
    "test:ui": "jest --config jest.config.cjs --runInBand --randomize --showSeed",
    "test:device": "node scripts/run-device-replay.mjs",
    "test:device:logged-out": "node scripts/run-logged-out-device-replay.mjs",
    "test:native:forum-selection": "node scripts/run-forum-selection-native-tests.mjs unit",
    "test:instrumented:forum-selection": "node scripts/run-forum-selection-native-tests.mjs instrumented",
    "test:docs": "node --test scripts/check-docs.test.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:react": "npx --yes react-doctor@0.9.3 . --no-warnings --no-telemetry --no-dead-code --no-supply-chain --blocking error",
    "check:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters --allowUnreachableCode false --allowUnusedLabels false",
    "verify": "npm run lint && npm run format:check && npm run check:architecture && npm run test:architecture && npm test && npm run test:ui && npm run test:docs && npm run check:docs && npm run typecheck && npm run check:unused && node scripts/check-version.mjs",
    "preandroid": "npm run build:composer",
    "android": "expo run:android",
    "prerelease:android": "npm run build:composer",
    "release:android": "node scripts/release-android.mjs",
    "presmoke:android": "npm run build:composer",
    "smoke:android": "node scripts/smoke-android.mjs",
    "pretypecheck": "npm run build:composer",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.2",
    "@codemirror/view": "6.43.10",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@radix-ui/react-popover": "1.1.23",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.2.0",
    "@react-native-community/slider": "5.2.1",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "5.102.8",
    "@tiptap/core": "3.31.0",
    "@tiptap/extension-image": "3.31.0",
    "@tiptap/extension-table": "3.31.0",
    "@tiptap/extension-task-item": "3.31.0",
    "@tiptap/extension-task-list": "3.31.0",
    "@tiptap/markdown": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/react": "3.31.0",
    "@tiptap/starter-kit": "3.31.0",
    "anser": "^2.3.5",
    "buffer": "^6.0.3",
    "dompurify": "3.4.14",
    "expo": "~57.0.19",
    "expo-background-task": "~57.0.15",
    "expo-build-properties": "~57.0.16",
    "expo-clipboard": "~57.0.1",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-image": "~57.0.4",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.16",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.15",
    "expo-video": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "fast-xml-parser": "^5.11.1",
    "lucide-react-native": "^1.39.0",
    "markdown-it": "15.0.1",
    "markdown-it-task-lists": "2.1.1",
    "node-html-parser": "^9.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "3.2.1",
    "react-native-pager-view": "9.0.4",
    "react-native-reanimated": "4.5.1",
    "react-native-render-html": "6.3.4",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-tab-view": "^4.3.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.10.4",
    "react-native-zoom-toolkit": "^5.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.18",
    "@types/react-dom": "19.2.5",
    "babel-preset-expo": "~57.0.10",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "jsdom": "^30.0.1",
    "patch-package": "8.0.1",
    "prettier": "^3.9.6",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
