diff --git a/node_modules/expo-video/android/src/main/java/expo/modules/video/utils/ReadNetworkVideoClientRegistry.kt b/node_modules/expo-video/android/src/main/java/expo/modules/video/utils/ReadNetworkVideoClientRegistry.kt
