+  field(resourceUri)
+  field(videoSource.contentType.value)
+  videoSource.headers.orEmpty().entries
+    .filterNot { it.key.equals(READ_NETWORK_GENERATION_HEADER, ignoreCase = true) }
+    .sortedBy { it.key.lowercase(java.util.Locale.ROOT) }
+    .forEach { field(it.key.lowercase(java.util.Locale.ROOT)); field(it.value) }
+  return digest.digest().joinToString("") { "%02x".format(it.toInt() and 0xff) }
