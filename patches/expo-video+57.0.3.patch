+  private fun awaitVisibleFrame(scenario: ActivityScenario<ReaderPlaybackTestActivity>, view: PlayerView, frame: Int) {
+    var observed: Int
+    val deadline = SystemClock.elapsedRealtime() + 4_000
+    do {
+      observed = windowFrame(scenario, view)
+      if (observed == frame) return
+      SystemClock.sleep(25)
+    } while (SystemClock.elapsedRealtime() < deadline)
+    var surface = -1
+    var info = ""
+    scenario.onActivity {
+      val texture = view.videoSurfaceView as TextureView
+      val origin = IntArray(2)
+      texture.getLocationInWindow(origin)
+      texture.getBitmap(40, 16)?.let { bitmap -> try { surface = decodeFrameNumber(bitmap) } finally { bitmap.recycle() } }
+      info = "origin=${origin.toList()} size=${texture.width}x${texture.height} state=${view.player?.playbackState} position=${view.player?.currentPosition}"
+    }
+    fail("Visible handoff frame expected=$frame observed=$observed surface=$surface $info")
+  }
+
+  private fun windowFrame(scenario: ActivityScenario<ReaderPlaybackTestActivity>, view: PlayerView): Int {
+    val result = AtomicInteger(-1)
+    val ready = CountDownLatch(1)
+    val bitmap = Bitmap.createBitmap(40, 16, Bitmap.Config.ARGB_8888)
+    try {
+      scenario.onActivity { activity ->
+        val texture = view.videoSurfaceView as TextureView
+        val origin = IntArray(2)
+        texture.getLocationInWindow(origin)
+        if (texture.width == 0 || texture.height == 0) { ready.countDown(); return@onActivity }
+        val rect = Rect(origin[0], origin[1], origin[0] + texture.width, origin[1] + texture.height)
+        PixelCopy.request(activity.window, rect, bitmap, { status -> result.set(status); ready.countDown() }, Handler(Looper.getMainLooper()))
+      }
+      assertTrue("PixelCopy callback timed out", ready.await(2, TimeUnit.SECONDS))
+      return if (result.get() == PixelCopy.SUCCESS) decodeFrameNumber(bitmap) else -1
+    } finally { bitmap.recycle() }
+  }
+
+  private fun decodeFrameNumber(bitmap: Bitmap): Int {
+    var decoded = 0
+    for (bit in 0 until 10) {
+      val red = Color.red(bitmap.getPixel(4 * bit + 2, 8))
+      if (red in 73..179) return -1
+      if (red >= 180) decoded = decoded or (1 shl bit)
+    }
+    return decoded
+  }
