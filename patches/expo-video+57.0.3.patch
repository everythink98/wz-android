+// Hash the complete representation identity; transport rotation does not change the resource.
+fun forumVideoCacheKey(videoSource: VideoSource, resourceUri: String): String {
+  val digest = MessageDigest.getInstance("SHA-256")
+  fun field(value: String) {
+    val bytes = value.toByteArray(Charsets.UTF_8)
+    digest.update(java.nio.ByteBuffer.allocate(4).putInt(bytes.size).array())
+    digest.update(bytes)
+  }
