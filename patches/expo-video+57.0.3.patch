+  private fun clickNativeMenuText(text: String, popupBottomRange: IntRange) {
+    val deadline = SystemClock.elapsedRealtime() + 5000
+    var nextScroll = SystemClock.elapsedRealtime() + 250
+    var lastPopupBounds: android.graphics.Rect? = null
+    do {
+      val root = instrumentation.uiAutomation.rootInActiveWindow
+      val items = root?.findAccessibilityNodeInfosByText(text).orEmpty()
+      for (item in items.filter { it.text?.toString() == text }) {
+        val control = generateSequence(item) { it.parent }.firstOrNull { it.isClickable }
+        if (control != null && root != null) {
+          val popupBounds = android.graphics.Rect()
+          root.getBoundsInScreen(popupBounds)
+          lastPopupBounds = popupBounds
+          if (popupBounds.bottom in popupBottomRange && control.performAction(android.view.accessibility.AccessibilityNodeInfo.ACTION_CLICK)) return
+        }
+      }
+      if (root != null && SystemClock.elapsedRealtime() >= nextScroll) {
+        // Media3 clips the popup to the height of the inline controller, so speed rows can require scrolling.
+        val queue = ArrayDeque(listOf(root))
+        while (queue.isNotEmpty()) {
+          val node = queue.removeFirst()
+          if (node.isScrollable && node.performAction(android.view.accessibility.AccessibilityNodeInfo.ACTION_SCROLL_FORWARD)) {
+            break
+          }
+          for (index in 0 until node.childCount) node.getChild(index)?.let(queue::addLast)
+        }
+        nextScroll = SystemClock.elapsedRealtime() + 350
+      }
+      SystemClock.sleep(50)
+    } while (SystemClock.elapsedRealtime() < deadline)
+    fail("Media3 menu item $text must be selectable with popup bottom in $popupBottomRange, last window=$lastPopupBounds")
+  }
