+  @Test fun compareBackBufferCandidatesForRenderedVideoSeek() {
+    val scenario = ActivityScenario.launch<ReaderPlaybackTestActivity>(Intent(context, ReaderPlaybackTestActivity::class.java))
+    try {
+      for ((keyframeSeconds, bitrate) in listOf(1 to 128_000, 5 to 1_500_000)) {
+        bytes = mp4(keyframeSeconds, bitrate)
+        mime = "video/mp4"
+        val cached = source().apply { uri = Uri.parse(server.url("/seek-$keyframeSeconds.mp4").toString()) }
+        read(cached, 0, bytes.size.toLong())
+        for (backBufferMs in listOf(0L, 10_000L, 30_000L)) {
+          val frameUs = java.util.concurrent.atomic.AtomicLong(-1)
+          val requestsBefore = ranges.size
+          var player: ExoPlayer? = null
+          try {
+            scenario.onActivity { activity ->
+              player = ExoPlayer.Builder(activity).setLoadControl(VideoPlayerLoadControl(backBufferMs)).build().apply {
+                setVideoFrameMetadataListener { timeUs, _, _, _ -> frameUs.set(timeUs) }
+                activity.playerView.player = this
+                setMediaSource(buildExpoVideoMediaSource(activity, cached))
+                prepare()
+                play()
+              }
+            }
+            awaitReady(player!!)
+            val until = SystemClock.elapsedRealtime() + 7000L
+            while (frameUs.get() < 3_000_000 && SystemClock.elapsedRealtime() < until) SystemClock.sleep(10)
+            assertTrue("Playback did not reach the test point", frameUs.get() >= 3_000_000)
+            val start = SystemClock.elapsedRealtime()
+            instrumentation.runOnMainSync {
+              player!!.pause()
+              player!!.seekTo(1_000)
+            }
+            while (kotlin.math.abs(frameUs.get() - 1_000_000L) > 150_000L && SystemClock.elapsedRealtime() - start < 5000L) {
+              SystemClock.sleep(5)
+            }
+            val seekMs = SystemClock.elapsedRealtime() - start
+            assertTrue("The requested video frame did not render", kotlin.math.abs(frameUs.get() - 1_000_000L) <= 150_000L)
+            val upstreamRequests = ranges.size - requestsBefore
+            assertEquals("A fully cached video should seek without another Range", 0, upstreamRequests)
+            Log.i("ReaderPlaybackProof", "backBufferMs=$backBufferMs keyframeSeconds=$keyframeSeconds bitrate=$bitrate seekMs=$seekMs requests=$upstreamRequests pssKiB=${android.os.Debug.getPss()}")
+          } finally {
+            scenario.onActivity { activity ->
+              activity.playerView.player = null
+              player?.release()
+            }
+          }
+        }
+      }
+    } finally {
+      scenario.close()
+    }
+  }
