+package expo.modules.video
+
+import android.net.Uri
+import android.content.Intent
+import android.media.MediaCodec
+import android.media.MediaCodecInfo
+import android.media.MediaFormat
+import android.media.MediaMuxer
+import android.os.SystemClock
+import android.util.Log
+import androidx.media3.common.C
+import androidx.media3.common.Player
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.datasource.DataSpec
+import androidx.media3.exoplayer.ExoPlayer
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.core.app.ActivityScenario
+import androidx.test.platform.app.InstrumentationRegistry
+import expo.modules.video.managers.VideoManager
+import expo.modules.video.records.VideoSource
+import okhttp3.OkHttpClient
+import okhttp3.mockwebserver.Dispatcher
+import okhttp3.mockwebserver.MockResponse
+import okhttp3.mockwebserver.MockWebServer
+import okhttp3.mockwebserver.RecordedRequest
+import okio.Buffer
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.util.Collections
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+
+@androidx.annotation.OptIn(UnstableApi::class)
+@RunWith(AndroidJUnit4::class)
+class ReaderPlaybackInstrumentedTest {
+  private val instrumentation = InstrumentationRegistry.getInstrumentation()
+  private val context get() = instrumentation.targetContext
+  private lateinit var server: MockWebServer
+  private val ranges = Collections.synchronizedList(mutableListOf<String>())
+  private var bytes = wav()
+  private var mime = "audio/wav"
+  private val client = OkHttpClient()
+
+  @Before fun setup() {
+    VideoManager.cache = VideoCache(context)
+    VideoManager.cache.setMaxCacheSize(256 * 1024 * 1024L)
+    VideoManager.cache.clear()
+    server = MockWebServer()
+    server.dispatcher = object : Dispatcher() {
+      override fun dispatch(request: RecordedRequest): MockResponse {
+        val range = request.getHeader("Range")
+        ranges.add(range ?: "full")
+        val match = range?.let { Regex("bytes=(\\d+)-(\\d*)").matchEntire(it) }
+        val start = match?.groupValues?.get(1)?.toInt() ?: 0
+        val end = match?.groupValues?.get(2)?.toIntOrNull()?.coerceAtMost(bytes.lastIndex) ?: bytes.lastIndex
+        if (start > end) return MockResponse().setResponseCode(416)
+        return MockResponse().setResponseCode(if (range == null) 200 else 206)
+          .setHeader("Content-Type", mime)
+          .setHeader("Accept-Ranges", "bytes")
+          .setHeader("Content-Range", "bytes $start-$end/${bytes.size}")
+          .setBody(Buffer().write(bytes, start, end - start + 1))
+      }
+    }
+    server.start()
+    ReadNetworkVideoClientRegistry.register(9L, client)
+  }
+
+  @After fun teardown() {
+    VideoManager.cache.release()
+    ReadNetworkVideoClientRegistry.unregister(9L, client)
+    client.dispatcher.executorService.shutdown()
+    client.connectionPool.evictAll()
+    server.shutdown()
+  }
+
+  private fun source(cached: Boolean = true, identity: String = "forum:epoch-1", referer: String = "https://example.invalid/") = VideoSource(
+    uri = Uri.parse(server.url("/fixture.wav").toString()),
+    useCaching = cached,
+    contentType = expo.modules.video.enums.ContentType.PROGRESSIVE,
+    headers = mapOf(
+      READ_NETWORK_GENERATION_HEADER to "9",
+      "X-WZ-Forum-Media-Source" to "nodeseek",
+      "X-WZ-Forum-Media-Identity" to identity,
+      "Referer" to referer
+    )
+  )
+
+  private fun read(source: VideoSource, start: Long, length: Long) {
+    val factory = if (source.useCaching) buildCacheDataSourceFactory(context, source) else buildBaseDataSourceFactory(context, source)
+    val data = factory.createDataSource()
+    val output = Buffer()
+    try {
+      data.open(DataSpec.Builder().setUri(source.uri!!).setPosition(start).setLength(length).build())
+      val block = ByteArray(4096)
+      while (true) {
+        val count = data.read(block, 0, block.size)
+        if (count == C.RESULT_END_OF_INPUT) break
+        output.write(block, 0, count)
+      }
+      assertArrayEquals(bytes.copyOfRange(start.toInt(), (start + length).toInt()), output.readByteArray())
+    } finally { data.close() }
+  }
+
+  @Test fun cachedRangesAvoidUpstreamAndTransportRotationPreservesIdentity() {
+    val uncached = source(false)
+    repeat(2) { read(uncached, 1000, 4000) }
+    assertEquals(2, ranges.size) // Negative control matching the previous production source.
+    val cached = source()
+    read(cached, 0, bytes.size.toLong())
+    val loadedRequests = ranges.size
+    for (position in listOf(6000L, 1000L, 18000L, 0L)) read(cached, position, 4000)
+    cached.headers = cached.headers!! + (READ_NETWORK_GENERATION_HEADER to "10")
+    read(cached, 8000, 4000)
+    assertEquals(loadedRequests, ranges.size)
+    Log.i("ReaderPlaybackProof", "cached-seek upstreamRequests=0 ranges=$ranges")
+  }
+
+  @Test fun uncachedRangesAndDifferentRepresentationsReachTheServer() {
+    val cached = source()
+    read(cached, 0, 4000)
+    read(cached, 12000, 4000)
+    assertEquals(listOf("bytes=0-3999", "bytes=12000-15999"), ranges.toList())
+    read(source(identity = "forum:epoch-2"), 0, 4000)
+    read(source(referer = "https://other.invalid/"), 0, 4000)
+    assertEquals(4, ranges.size)
+    val key = forumVideoCacheKey(cached, cached.uri.toString())
+    assertTrue(key.matches(Regex("[0-9a-f]{64}")))
+    assertFalse(key.contains("epoch"))
+  }
+
+  @Test fun evictionRemainsBoundedAndMissingCachedSpansReload() {
+    VideoManager.cache.setMaxCacheSize(8192)
+    val cached = source()
+    read(cached, 0, 4000)
+    read(cached, 8000, 4000)
+    read(cached, 16000, 4000)
+    assertTrue(VideoManager.cache.instance.cacheSpace <= 8192)
+    val before = ranges.size
+    read(cached, 0, 4000)
+    assertEquals(before + 1, ranges.size)
+    // Restore only this test APK's cache setting.
+    VideoManager.cache.setMaxCacheSize(256 * 1024 * 1024L)
+  }
+
+  @Test fun missingCacheFileFallsBackToUpstream() {
+    val cached = source()
+    read(cached, 0, 4000)
+    val key = forumVideoCacheKey(cached, cached.uri.toString())
+    val span = VideoManager.cache.instance.getCachedSpans(key).first()
+    assertTrue(span.file!!.delete())
+    read(cached, 0, 4000)
+    assertEquals(2, ranges.size)
+  }
+
+  @Test fun downloadedVideoSeeksRenderFramesAndKeepCompactNativeControls() {
+    bytes = mp4()
+    mime = "video/mp4"
+    val cached = source().apply { uri = Uri.parse(server.url("/fixture.mp4").toString()) }
+    read(cached, 0, bytes.size.toLong())
+    val requests = ranges.size
+    val frameUs = java.util.concurrent.atomic.AtomicLong(-1L)
+    val scenario = ActivityScenario.launch<ReaderPlaybackTestActivity>(Intent(context, ReaderPlaybackTestActivity::class.java))
+    var player: ExoPlayer? = null
+    try {
+      scenario.onActivity { activity ->
+        player = ExoPlayer.Builder(activity).build().apply {
+          setVideoFrameMetadataListener { presentationTimeUs, _, _, _ -> frameUs.set(presentationTimeUs) }
+          activity.playerView.player = this
+          setMediaSource(buildExpoVideoMediaSource(activity, cached))
+          prepare()
+        }
+      }
+      awaitReady(player!!)
+      for ((index, position) in listOf(3000L, 1000L, 6000L, 2000L, 7900L, 0L).withIndex()) {
+        val started = SystemClock.elapsedRealtime()
+        instrumentation.runOnMainSync { player!!.playWhenReady = index % 2 == 0; player!!.seekTo(position) }
+        awaitReady(player!!)
+        val deadline = SystemClock.elapsedRealtime() + 10_000
+        while (kotlin.math.abs(frameUs.get() / 1000 - position) > 500 && SystemClock.elapsedRealtime() < deadline) SystemClock.sleep(10)
+        assertTrue("No decoded frame near $position; last=${frameUs.get()}", kotlin.math.abs(frameUs.get() / 1000 - position) <= 500)
+        Log.i("ReaderPlaybackProof", "videoSeekMs=$position frameMs=${SystemClock.elapsedRealtime() - started} upstreamRequests=${ranges.size - requests}")
+      }
+      assertEquals(requests, ranges.size)
+      scenario.onActivity { activity ->
+        player!!.pause()
+        for (fullscreen in listOf(false, true)) {
+          activity.playerView.applyReaderControls(fullscreen)
+          activity.playerView.showController()
+          val button = activity.playerView.findViewById<android.widget.ImageButton>(androidx.media3.ui.R.id.exo_play_pause)
+          val density = activity.resources.displayMetrics.density
+          assertEquals((56 * density).toInt(), button.layoutParams.width)
+          val expectedIcon = ((if (fullscreen) 48 else 40) * density).toInt()
+          assertTrue(kotlin.math.abs(expectedIcon - (button.layoutParams.width - button.paddingLeft - button.paddingRight)) <= 1)
+          assertNotNull(button.contentDescription)
+        }
+        activity.playerView.applyReaderControls(false)
+      }
+      instrumentation.waitForIdleSync()
+      val bitmap = instrumentation.uiAutomation.takeScreenshot()
+      try {
+        val target = java.io.File(context.getExternalFilesDir(null), "reader-video-controls.png")
+        target.outputStream().use { bitmap.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, it) }
+      } finally { bitmap.recycle() }
+    } finally {
+      instrumentation.runOnMainSync { player?.release() }
+      scenario.close()
+    }
+  }
+
+  @Test fun realPlayerSeeksWithinDownloadedAudioWithoutNewRequests() {
+    val cached = source()
+    read(cached, 0, bytes.size.toLong())
+    val requests = ranges.size
+    var player: ExoPlayer? = null
+    try {
+      instrumentation.runOnMainSync {
+        player = ExoPlayer.Builder(context).build().apply {
+          setMediaSource(buildExpoVideoMediaSource(context, cached))
+          prepare()
+        }
+      }
+      awaitReady(player!!)
+      for ((index, position) in listOf(3000L, 1000L, 6000L, 2000L, 7900L, 0L).withIndex()) {
+        val started = SystemClock.elapsedRealtime()
+        instrumentation.runOnMainSync { player!!.playWhenReady = index % 2 == 0; player!!.seekTo(position) }
+        awaitReady(player!!)
+        instrumentation.runOnMainSync { assertTrue(kotlin.math.abs(player!!.currentPosition - position) < 1000L) }
+        Log.i("ReaderPlaybackProof", "seekMs=$position readyMs=${SystemClock.elapsedRealtime() - started}")
+      }
+      assertEquals(requests, ranges.size)
+    } finally { instrumentation.runOnMainSync { player?.release() } }
+  }
+
+  private fun awaitReady(player: ExoPlayer) {
+    val ready = CountDownLatch(1)
+    var error: Exception? = null
+    val listener = object : Player.Listener {
+      override fun onPlaybackStateChanged(state: Int) { if (state == Player.STATE_READY) ready.countDown() }
+      override fun onPlayerError(failure: androidx.media3.common.PlaybackException) { error = failure; ready.countDown() }
+    }
+    instrumentation.runOnMainSync {
+      player.addListener(listener)
+      if (player.playbackState == Player.STATE_READY) ready.countDown()
+    }
+    try { assertTrue("Player did not become ready", ready.await(15, TimeUnit.SECONDS)); error?.let { throw it } }
+    finally { instrumentation.runOnMainSync { player.removeListener(listener) } }
+  }
+
+  private fun wav(): ByteArray {
+    val samples = 8000 * 8
+    return ByteBuffer.allocate(44 + samples * 2).order(ByteOrder.LITTLE_ENDIAN).apply {
+      put("RIFF".toByteArray()); putInt(36 + samples * 2); put("WAVEfmt ".toByteArray())
+      putInt(16); putShort(1); putShort(1); putInt(8000); putInt(16000); putShort(2); putShort(16)
+      put("data".toByteArray()); putInt(samples * 2)
+      repeat(samples) { putShort(0) }
+    }.array()
+  }
+
+  private fun mp4(): ByteArray {
+    val file = java.io.File(context.cacheDir, "reader-playback-fixture.mp4")
+    val codec = MediaCodec.createEncoderByType("video/avc")
+    val muxer = MediaMuxer(file.absolutePath, MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4)
+    var muxing = false
+    try {
+      codec.configure(MediaFormat.createVideoFormat("video/avc", 160, 96).apply {
+        setInteger(MediaFormat.KEY_COLOR_FORMAT, MediaCodecInfo.CodecCapabilities.COLOR_FormatYUV420Flexible)
+        setInteger(MediaFormat.KEY_BIT_RATE, 128_000)
+        setInteger(MediaFormat.KEY_FRAME_RATE, 10)
+        setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 1)
+      }, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)
+      codec.start()
+      var frame = 0
+      var track = -1
+      val info = MediaCodec.BufferInfo()
+      val deadline = SystemClock.elapsedRealtime() + 30_000
+      while (SystemClock.elapsedRealtime() < deadline) {
+        if (frame <= 80) {
+          val inputIndex = codec.dequeueInputBuffer(10_000)
+          if (inputIndex >= 0) {
+            val data = ByteArray(160 * 96 * 3 / 2) { 128.toByte() }
+            java.util.Arrays.fill(data, 0, 160 * 96, (32 + frame * 2).toByte())
+            codec.getInputBuffer(inputIndex)!!.put(data)
+            codec.queueInputBuffer(inputIndex, 0, if (frame == 80) 0 else data.size, frame * 100_000L,
+              if (frame == 80) MediaCodec.BUFFER_FLAG_END_OF_STREAM else 0)
+            frame++
+          }
+        }
+        val index = codec.dequeueOutputBuffer(info, 10_000)
+        if (index == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
+          track = muxer.addTrack(codec.outputFormat); muxer.start(); muxing = true
+        } else if (index >= 0) {
+          if (info.size > 0 && info.flags and MediaCodec.BUFFER_FLAG_CODEC_CONFIG == 0) muxer.writeSampleData(track, codec.getOutputBuffer(index)!!, info)
+          codec.releaseOutputBuffer(index, false)
+          if (info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM != 0) break
+        }
+      }
+      check(muxing && frame == 81) { "Synthetic MP4 encoder did not finish" }
+      muxer.stop(); muxing = false
+      return file.readBytes()
+    } finally {
+      codec.stop(); codec.release()
+      if (muxing) muxer.stop()
+      muxer.release(); file.delete()
+    }
+  }
+}
