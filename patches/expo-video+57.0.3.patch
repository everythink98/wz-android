+  private fun awaitAudioPosition(player: ExoPlayer, expected: LongRange, timeoutMs: Long = 8_000) {
+    val limit = SystemClock.elapsedRealtime() + timeoutMs
+    do {
+      var playing = false
+      var position = -1L
+      instrumentation.runOnMainSync {
+        playing = player.isPlaying
+        position = player.currentPosition
+      }
+      if (playing && position in expected) return
+      SystemClock.sleep(10)
+    } while (SystemClock.elapsedRealtime() < limit)
+    fail("Audio did not advance into $expected")
+  }
+
+  private fun awaitReady(player: ExoPlayer) {
+    val ready = CountDownLatch(1)
+    var error: Exception? = null
+    val listener = object : Player.Listener {
+      override fun onPlaybackStateChanged(state: Int) { if (state == Player.STATE_READY) ready.countDown() }
+      override fun onPlayerError(failure: androidx.media3.common.PlaybackException) { error = failure; ready.countDown() }
+    }
+    instrumentation.runOnMainSync {
+      player.addListener(listener)
+      if (player.playbackState == Player.STATE_READY) ready.countDown()
+    }
+    try { assertTrue("Player did not become ready", ready.await(15, TimeUnit.SECONDS)); error?.let { throw it } }
+    finally { instrumentation.runOnMainSync { player.removeListener(listener) } }
+  }
+
+  private fun wav(seconds: Int = 8): ByteArray {
+    val samples = 8000 * seconds
+    return ByteBuffer.allocate(44 + samples * 2).order(ByteOrder.LITTLE_ENDIAN).apply {
+      put("RIFF".toByteArray()); putInt(36 + samples * 2); put("WAVEfmt ".toByteArray())
+      putInt(16); putShort(1); putShort(1); putInt(8000); putInt(16000); putShort(2); putShort(16)
+      put("data".toByteArray()); putInt(samples * 2)
+      repeat(samples) { putShort(0) }
+    }.array()
+  }
+
+  private fun mp4(keyframeSeconds: Int = 1, bitrate: Int = 128_000, longGop: Boolean = false): ByteArray {
+    val file = java.io.File(context.cacheDir, "reader-playback-fixture.mp4")
+    val codec = MediaCodec.createEncoderByType("video/avc")
+    val muxer = MediaMuxer(file.absolutePath, MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4)
+    var muxing = false
+    try {
+      val width = if (longGop) 320 else 160
+      val height = if (longGop) 192 else 96
+      val fps = if (longGop) 24 else 10
+      val seconds = if (longGop) 24 else 8
+      val endFrame = seconds * fps
+      val data = ByteArray(width * height * 3 / 2) { 128.toByte() }
+      val noise = ByteArray(width * height)
+      val random = java.util.Random(17)
+      val keyframeTimes = mutableListOf<Long>()
+      codec.configure(MediaFormat.createVideoFormat("video/avc", width, height).apply {
+        setInteger(MediaFormat.KEY_COLOR_FORMAT, MediaCodecInfo.CodecCapabilities.COLOR_FormatYUV420Flexible)
+        setInteger(MediaFormat.KEY_BIT_RATE, bitrate)
+        setInteger(MediaFormat.KEY_FRAME_RATE, fps)
+        setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, keyframeSeconds)
+      }, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)
+      codec.start()
+      var frame = 0
+      var track = -1
+      val info = MediaCodec.BufferInfo()
+      val deadline = SystemClock.elapsedRealtime() + if (longGop) 120_000L else 30_000L
+      while (SystemClock.elapsedRealtime() < deadline) {
+        if (frame <= endFrame) {
+          val inputIndex = codec.dequeueInputBuffer(10_000)
+          if (inputIndex >= 0) {
+            if (longGop) {
+              random.nextBytes(noise)
+              noise.copyInto(data)
+              // Encode the individual frame number in ten grayscale blocks across the center strip.
+              for (row in height / 2 - 20 until height / 2 + 20) for (bit in 0 until 10) {
+                val start = row * width + bit * width / 10
+                val end = row * width + (bit + 1) * width / 10
+                java.util.Arrays.fill(data, start, end, if (frame and (1 shl bit) == 0) 32.toByte() else 216.toByte())
+              }
+            } else {
+              java.util.Arrays.fill(data, 0, width * height, (32 + frame * 2).toByte())
+            }
+            codec.getInputBuffer(inputIndex)!!.put(data)
+            codec.queueInputBuffer(inputIndex, 0, if (frame == endFrame) 0 else data.size, frame * 1_000_000L / fps,
+              if (frame == endFrame) MediaCodec.BUFFER_FLAG_END_OF_STREAM else 0)
+            frame++
+          }
+        }
+        val index = codec.dequeueOutputBuffer(info, 10_000)
+        if (index == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
+          track = muxer.addTrack(codec.outputFormat); muxer.start(); muxing = true
+        } else if (index >= 0) {
+          if (info.size > 0 && info.flags and MediaCodec.BUFFER_FLAG_CODEC_CONFIG == 0) {
+            muxer.writeSampleData(track, codec.getOutputBuffer(index)!!, info)
+            if (info.flags and MediaCodec.BUFFER_FLAG_KEY_FRAME != 0) keyframeTimes.add(info.presentationTimeUs)
+          }
+          codec.releaseOutputBuffer(index, false)
+          if (info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM != 0) break
+        }
+      }
+      check(muxing && frame == endFrame + 1 && info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM != 0) { "Synthetic MP4 encoder did not finish" }
+      muxer.stop(); muxing = false
+      if (longGop) {
+        val gapUs = (keyframeTimes + seconds * 1_000_000L).zipWithNext { first, next -> next - first }.maxOrNull() ?: 0
+        val measuredBitrate = file.length() * 8 / seconds
+        val lateTargets = listOf(11_375_000L, 22_375_000L)
+        check(lateTargets.all { target -> keyframeTimes.lastOrNull { it <= target }?.let { target - it >= 8_000_000L } == true } &&
+          gapUs >= 10_000_000 && measuredBitrate >= 4_000_000) {
+          "Fixture does not meet long GOP/high bitrate requirement: keyframes=$keyframeTimes gapUs=$gapUs bitrate=$measuredBitrate"
+        }
+        Log.i("ReaderPlaybackProof", "fixture keyframes=$keyframeTimes gapUs=$gapUs bitrate=$measuredBitrate")
+      }
+      return file.readBytes()
+    } finally {
+      codec.stop(); codec.release()
+      if (muxing) muxer.stop()
+      muxer.release(); file.delete()
+    }
+  }
+}
