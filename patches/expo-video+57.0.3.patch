+  val touchTarget = (48 * resources.displayMetrics.density).toInt()
+  val compactParams = LinearLayout.LayoutParams(touchTarget, touchTarget).apply { gravity = Gravity.CENTER_VERTICAL }
+  val update = Runnable {
+    if (!isAttachedToWindow) return@Runnable
