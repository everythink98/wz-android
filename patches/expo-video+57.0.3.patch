+        val requestsBeforeColdSeek = ranges.size
+        val coldStart = SystemClock.elapsedRealtime()
+        instrumentation.runOnMainSync { activePlayer.seekTo(35_000) }
+        awaitAudioPosition(activePlayer, 35_060L..35_500L)
+        val coldSeekMs = SystemClock.elapsedRealtime() - coldStart
+        val coldRequests = ranges.size - requestsBeforeColdSeek
+        assertTrue("A seek to uncached audio should reach the upstream", coldRequests > 0)
+        Log.i("ReaderPlaybackProof", "throttledAudio backBufferMs=${backBufferMs ?: "production"} backMs=$backSeekMs backRequests=$backRequests coldMs=$coldSeekMs coldRequests=$coldRequests pssKiB=${android.os.Debug.getPss()}")
+        if (backBufferMs == null) assertEquals("A short backward seek should reuse buffered audio", 0, backRequests)
