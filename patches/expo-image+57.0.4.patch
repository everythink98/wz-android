+package expo.modules.image.events
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class GlideRequestListenerTest {
+  @Test
+  fun usesOriginalDimensionsCapturedDuringDownsampling() {
+    assertEquals(
+      1_000 to 5_000,
+      resolveImageLoadDimensions(
+        sourceWidth = 1_000,
+        sourceHeight = 5_000,
+        decodedWidth = 68,
+        decodedHeight = 342
+      )
+    )
+  }
+
+  @Test
+  fun fallsBackToDecodedDimensionsWhenOriginalDimensionsAreUnavailable() {
+    assertEquals(
+      68 to 342,
+      resolveImageLoadDimensions(
+        sourceWidth = -1,
+        sourceHeight = -1,
+        decodedWidth = 68,
+        decodedHeight = 342
+      )
+    )
+    assertEquals(
+      68 to 342,
+      resolveImageLoadDimensions(
+        sourceWidth = 1_000,
+        sourceHeight = -1,
+        decodedWidth = 68,
+        decodedHeight = 342
+      )
+    )
+  }
+}
