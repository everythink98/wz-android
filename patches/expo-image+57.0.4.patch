+  private fun rasterize(picture: Picture): BitmapResource {
+    val scale = minOf(1.0, MAX_RASTERIZED_SVG_EDGE.toDouble() / maxOf(picture.width, picture.height))
+    val width = (picture.width * scale).roundToInt().coerceAtLeast(1)
+    val height = (picture.height * scale).roundToInt().coerceAtLeast(1)
+    val pool = Glide.get(context).bitmapPool
+    val bitmap = pool.get(width, height, Bitmap.Config.ARGB_8888)
+    bitmap.density = context.resources.displayMetrics.densityDpi
+    Trace.beginSection("WZ.Image.RasterizeSvg")
+    try {
+      Canvas(bitmap).drawPicture(picture, Rect(0, 0, width, height))
+      return BitmapResource(bitmap, pool)
+    } catch (error: RuntimeException) {
+      pool.put(bitmap)
+      throw error
+    } finally {
+      Trace.endSection()
+    }
   }
 }
