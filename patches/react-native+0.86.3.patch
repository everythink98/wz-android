+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33])
+class ReactOkHttpNetworkFetcherTest {
+  @After
+  fun resetInjection() {
+    FrescoModule::class.java.getDeclaredField("networkFetcherFactory").apply {
+      isAccessible = true
+      set(null, null)
+    }
+  }
+
+  @Test
+  fun retainedFetcherUsesInjectedFactoryAndIndependentCancellationExecutor() {
+    val observed = AtomicReference<Request>()
+    fun client() = OkHttpClient.Builder().addInterceptor { chain ->
+      observed.set(chain.request())
+      Response.Builder().request(chain.request()).protocol(Protocol.HTTP_1_1)
+          .code(200).message("OK").body("image".toResponseBody()).build()
+    }.build()
+    val old = client()
+    val current = AtomicReference(old)
+    val cancellations = AtomicInteger()
+    FrescoModule.setNetworkFetcherFactory(
+        Call.Factory { current.get().newCall(it) },
+        Executor { cancellations.incrementAndGet(); it.run() })
+    val fetcher = FrescoModule.createNetworkFetcher(old)
+    current.set(client())
+    old.dispatcher.executorService.shutdown()
+    try {
+      val context = mock<ProducerContext>()
+      val cancellation = AtomicReference<ProducerContextCallbacks>()
+      whenever(context.imageRequest).thenReturn(ReactNetworkImageRequest.fromBuilderWithHeaders(
+          ImageRequestBuilder.newBuilderWithSource(Uri.parse("https://example.test/image")),
+          JavaOnlyMap.of("X-Test", "retained"), ImageCacheControl.RELOAD))
+      doAnswer { cancellation.set(it.getArgument(0)); null }.whenever(context).addCallbacks(any())
+      val completed = CountDownLatch(1)
+      val result = AtomicReference<String>()
+      fetcher.fetch(fetcher.createFetchState(mock(), context), object : NetworkFetcher.Callback {
+        override fun onResponse(stream: InputStream, length: Int) {
+          result.set(stream.bufferedReader().readText()); completed.countDown()
+        }
+        override fun onFailure(error: Throwable) { completed.countDown() }
+        override fun onCancellation() { completed.countDown() }
+      })
+      assertTrue(completed.await(5, TimeUnit.SECONDS))
+      assertEquals("image", result.get())
+      assertEquals("retained", observed.get().header("X-Test"))
+      assertTrue(observed.get().cacheControl.noCache)
+      cancellation.get().onCancellationRequested()
+      assertEquals(1, cancellations.get())
+    } finally { current.get().dispatcher.executorService.shutdown(); current.get().connectionPool.evictAll() }
+  }
+
+  @Test
+  fun defaultFetcherStillUsesTheSuppliedClient() {
+    val calls = AtomicInteger()
+    val client = OkHttpClient.Builder().eventListenerFactory { calls.incrementAndGet(); okhttp3.EventListener.NONE }.build()
+    val fetcher = FrescoModule.createNetworkFetcher(client)
+    val factory = com.facebook.imagepipeline.backends.okhttp3.OkHttpNetworkFetcher::class.java
+        .getDeclaredField("callFactory").apply { isAccessible = true }.get(fetcher) as Call.Factory
+    factory.newCall(Request.Builder().url("https://example.test/image").build())
+    assertEquals(1, calls.get())
+    assertSame(client, factory)
+  }
