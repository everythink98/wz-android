+import org.assertj.core.api.Assertions.assertThat
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.GraphicsMode
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35])
+@GraphicsMode(GraphicsMode.Mode.NATIVE)
+class CustomLineHeightSpanTest {
+  @Test
+  fun `plain text retains explicit tight line height`() {
+    val text = SpannableStringBuilder("ordinary text wraps across several lines without an attachment")
+    text.setSpan(CustomLineHeightSpan(18f), 0, text.length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+    val paint = TextPaint().apply { textSize = 20f }
+    val layout = StaticLayout.Builder.obtain(text, 0, text.length, paint, 160).setIncludePad(false).build()
+    assertThat(layout.lineCount).isGreaterThan(1)
+    for (line in 0 until layout.lineCount) {
+      assertThat(layout.getLineBottom(line) - layout.getLineTop(line)).isEqualTo(18)
+    }
+  }
+
+  @Test
+  fun `text after a tall inline view draws inside its own fixed height lines`() {
+    for (imageHeight in listOf(60, 600)) for (fontSize in listOf(20, 28)) {
+    val prefix = "前文 before "
+    val suffix = " 后续文字仍然完整显示 after the image wraps onto several ordinary text lines"
+    val text = SpannableStringBuilder(prefix + "\uFFFC" + suffix)
+    val anchor = prefix.length
+    text.setSpan(TextInlineViewPlaceholderSpan(1, 290, imageHeight), anchor, anchor + 1, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+    for ((start, end) in listOf(0 to anchor, anchor + 1 to text.length)) {
+      text.setSpan(AbsoluteSizeSpan(fontSize), start, end, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+      text.setSpan(CustomLineHeightSpan(fontSize * 1.6f), start, end, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+    }
+    val paint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply { textSize = 20f; color = Color.BLACK }
+    val layout = StaticLayout.Builder.obtain(text, 0, text.length, paint, 320)
+      .setIncludePad(false).setBreakStrategy(Layout.BREAK_STRATEGY_HIGH_QUALITY).build()
+    val bitmap = Bitmap.createBitmap(320, layout.height, Bitmap.Config.ARGB_8888)
+    val canvas = Canvas(bitmap)
+    canvas.drawColor(Color.WHITE)
+    layout.draw(canvas)
+    val imageLine = layout.getLineForOffset(anchor)
+    assertThat(layout.getLineBottom(imageLine) - layout.getLineTop(imageLine)).isGreaterThanOrEqualTo(imageHeight)
+    assertThat(layout.lineCount).isGreaterThan(imageLine + 1)
+    for (line in imageLine + 1 until layout.lineCount) {
+      val top = layout.getLineTop(line)
+      val bottom = layout.getLineBottom(line)
+      assertThat(bottom - top).describedAs("ordinary line %s height", line).isEqualTo(kotlin.math.ceil(fontSize * 1.6).toInt())
+      assertThat(layout.getLineBaseline(line)).describedAs("line %s baseline", line).isBetween(top, bottom)
+      var ink = 0
+      for (y in top until bottom) for (x in 0 until bitmap.width) {
+        if (Color.red(bitmap.getPixel(x, y)) < 128) ink++
+      }
+      assertThat(ink).describedAs("line %s visible text", line).isGreaterThan(0)
+    }
+    bitmap.recycle()
+    }
+  }
+}
