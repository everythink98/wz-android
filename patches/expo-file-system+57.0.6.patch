+package expo.modules.filesystem
+
+import android.net.Uri
+import com.facebook.react.modules.network.OkHttpClientProvider
+import kotlinx.coroutines.runBlocking
+import okhttp3.Protocol
+import okhttp3.Response
+import okhttp3.ResponseBody.Companion.toResponseBody
+import java.net.URI
+import expo.modules.filesystem.unifiedfile.JavaFile
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import java.io.File
+import java.net.ServerSocket
+import kotlin.concurrent.thread
+
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, sdk = [35])
+class DownloadResponseTest {
+  private val payload = ByteArray(32768) { (it % 251).toByte() }
+
+  private fun transfer(
+    file: File,
+    offset: Long,
+    code: Int = 206,
+    contentRange: String? = "bytes $offset-${payload.size - 1}/${payload.size}",
+    disconnect: Boolean = false,
+    extraHeaders: String = "",
+    stopped: () -> Boolean = { false },
+    progress: (Long, Long) -> Unit = { _, _ -> }
+  ): Long? {
+    val bytes = if (code == 200) payload else payload.copyOfRange(offset.toInt(), payload.size)
+    ServerSocket(0).use { server ->
+      var requestRange: String? = null
+      val worker = thread {
+        server.accept().use { socket ->
+          val input = socket.getInputStream().bufferedReader()
+          while (true) {
+            val line = input.readLine() ?: break
+            if (line.isEmpty()) break
+            if (line.startsWith("Range:")) requestRange = line.substringAfter(':').trim()
+          }
+          val headers = "HTTP/1.1 $code Test\r\nContent-Length: ${bytes.size}\r\n" +
+            (contentRange?.let { "Content-Range: $it\r\n" } ?: "") + extraHeaders + "Connection: close\r\n\r\n"
+          socket.getOutputStream().apply {
+            write(headers.toByteArray())
+            write(if (disconnect) bytes.copyOf(bytes.size / 2) else bytes)
+            flush()
+          }
+        }
+      }
+      val client = OkHttpClient()
+      try {
+        val request = Request.Builder().url("http://127.0.0.1:${server.localPort}/app.apk")
+          .header("Range", "bytes=$offset-").header("Accept-Encoding", "identity").build()
+        return writeDownloadResponse(client.newCall(request).execute(), JavaFile(Uri.fromFile(file)),
+          true, offset, stopped, progress)
+      } finally {
+        worker.join(5000)
+        assertFalse(worker.isAlive)
+        assertEquals("bytes=$offset-", requestRange)
+        client.connectionPool.evictAll()
+        client.dispatcher.executorService.shutdown()
+      }
+    }
+  }
+
+  private fun withPartial(block: (File) -> Unit) {
+    val file = File.createTempFile("update-", ".part")
+    try { file.writeBytes(payload.copyOf(4096)); block(file) } finally { file.delete() }
+  }
+
+  @Test fun usesTheCurrentManagedClientAndHonorsItsBlock() = withPartial { file ->
+    val destination = FileSystemFile(Uri.fromFile(file))
+    // Supply the disk adapter without bootstrapping a JS runtime; exercise the real native task.
+    FileSystemPath::class.java.getDeclaredField("fileAdapter").apply { isAccessible = true }
+      .set(destination, JavaFile(Uri.fromFile(file)))
+    val options = DownloadTaskOptions().apply { headers = mapOf("Accept-Encoding" to "identity") }
+    val url = URI("http://127.0.0.1:9/app.apk")
+    var allowed = 0
+    val managed = OkHttpClient.Builder().addInterceptor { chain ->
+      allowed++
+      assertEquals("bytes=4096-", chain.request().header("Range"))
+      assertEquals("identity", chain.request().header("Accept-Encoding"))
+      Response.Builder().request(chain.request()).protocol(Protocol.HTTP_1_1).code(206).message("Partial")
+        .header("Content-Range", "bytes 4096-32767/32768")
+        .body(payload.copyOfRange(4096, payload.size).toResponseBody()).build()
+    }.build()
+    val blocked = OkHttpClient.Builder().addInterceptor { throw java.io.IOException("managed requests blocked") }.build()
+    try {
+      OkHttpClientProvider.setOkHttpClientFactory { managed }
+      val task = FileSystemDownloadTask()
+      runBlocking { task.resume(url, destination, "4096", options) }
+      assertEquals(1, allowed)
+      assertArrayEquals(payload, file.readBytes())
+      OkHttpClientProvider.setOkHttpClientFactory { blocked }
+      assertThrows(UnableToDownloadException::class.java) { runBlocking { task.start(url, destination, options) } }
+      assertArrayEquals(payload, file.readBytes())
+      assertEquals(1, allowed)
+      task.sharedObjectDidRelease()
+    } finally {
+      OkHttpClientProvider.setOkHttpClientFactory(null)
+      for (client in listOf(managed, blocked)) {
+        client.connectionPool.evictAll()
+        client.dispatcher.executorService.shutdown()
+      }
+    }
+  }
+
+  @Test fun resumesOnlyTheRemainingBytes() = withPartial { file ->
+    assertEquals(payload.size.toLong(), transfer(file, file.length()))
+    assertArrayEquals(payload, file.readBytes())
+  }
+
+  @Test fun replacesThePrefixWhenServerIgnoresRange() = withPartial { file ->
+    transfer(file, file.length(), code = 200, contentRange = null)
+    assertArrayEquals(payload, file.readBytes())
+  }
+
+  @Test fun rejectsInvalidRangesBeforeWriting() = withPartial { file ->
+    for (range in listOf(null, "bytes 0-32767/32768", "bytes 4096-20000/32768", "bytes 4096-32767/*", "bytes 4096-32767/999999999999999999999")) {
+      assertThrows(DownloadRangeException::class.java) { transfer(file, file.length(), contentRange = range) }
+      assertArrayEquals(payload.copyOf(4096), file.readBytes())
+    }
+    for (header in listOf("Content-Type: multipart/byteranges\r\n", "Content-Encoding: gzip\r\n",
+      "Content-Range: bytes 4096-32767/32768\r\n", "Content-Length: 12\r\n")) {
+      val error = assertThrows(DownloadRangeException::class.java) { transfer(file, file.length(), extraHeaders = header) }
+      assertEquals("ERR_DOWNLOAD_RANGE", error.code)
+      assertArrayEquals(payload.copyOf(4096), file.readBytes())
+    }
+  }
+
+  @Test fun preservesTheFileOnUnsatisfiableRange() = withPartial { file ->
+    val error = assertThrows(DownloadRangeNotSatisfiableException::class.java) { transfer(file, file.length(), code = 416) }
+    assertEquals("ERR_DOWNLOAD_RANGE_NOT_SATISFIABLE", error.code)
+    assertArrayEquals(payload.copyOf(4096), file.readBytes())
+  }
+
+  @Test fun resumesAfterAnInterruptedResponse() = withPartial { file ->
+    assertThrows(java.io.IOException::class.java) { transfer(file, file.length(), disconnect = true) }
+    assertTrue(file.length() > 4096)
+    transfer(file, file.length())
+    assertArrayEquals(payload, file.readBytes())
+  }
+
+  @Test fun pauseClosesTheWriterBeforeTheNextTransfer() = withPartial { file ->
+    var pause = false
+    assertNull(transfer(file, file.length(), stopped = { pause }, progress = { _, _ -> pause = true }))
+    val savedSize = file.length()
+    assertTrue(savedSize in 4097 until payload.size.toLong())
+    transfer(file, savedSize)
+    assertArrayEquals(payload, file.readBytes())
+  }
+}
