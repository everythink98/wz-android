+package expo.modules.filesystem
+
+import expo.modules.filesystem.unifiedfile.JavaFile
+import expo.modules.filesystem.unifiedfile.UnifiedFileInterface
+import expo.modules.kotlin.exception.CodedException
+import okhttp3.Response
+import java.io.FileOutputStream
+import java.io.IOException
+import java.io.RandomAccessFile
+
+internal class DownloadRangeException : CodedException("Invalid download byte range")
+internal class DownloadRangeNotSatisfiableException : CodedException("Download byte range is no longer available")
+
+/** Validates the response before touching the destination; settles only after both streams close. */
+internal fun writeDownloadResponse(
+  response: Response,
+  destination: UnifiedFileInterface,
+  isResume: Boolean,
+  offset: Long,
+  stopped: () -> Boolean,
+  progress: (Long, Long) -> Unit
+): Long? = response.use { resp ->
+  if (resp.code == 416) throw DownloadRangeNotSatisfiableException()
+  if (!resp.isSuccessful) throw UnableToDownloadException("HTTP ${resp.code}")
+  if (resp.code != 200 && resp.code != 206) throw DownloadRangeException()
+  val body = resp.body ?: throw UnableToDownloadException("Empty response body")
+  val length = body.contentLength()
+  val append = isResume && resp.code == 206
+  val start = if (append) offset else 0L
+  var total = length
+  if (resp.code == 206) {
+    if (resp.headers.values("Content-Range").size != 1) throw DownloadRangeException()
+    val match = Regex("bytes (\\d+)-(\\d+)/(\\d+)").matchEntire(resp.header("Content-Range") ?: "")
+      ?: throw DownloadRangeException()
+    val first = match.groupValues[1].toLongOrNull() ?: throw DownloadRangeException()
+    val last = match.groupValues[2].toLongOrNull() ?: throw DownloadRangeException()
+    total = match.groupValues[3].toLongOrNull() ?: throw DownloadRangeException()
+    if (first != start || first < 0 || last < first || total <= last || last != total - 1 ||
+      (length >= 0 && length != total - first) ||
+      resp.header("Content-Type")?.startsWith("multipart/", ignoreCase = true) == true ||
+      resp.header("Content-Encoding")?.let { !it.equals("identity", ignoreCase = true) } == true
+    ) throw DownloadRangeException()
+  }
+  if (stopped()) return null
+  if (destination is JavaFile) {
+    (destination.parentFile as? JavaFile)?.mkdirs()
+    if (append) {
+      if (offset < 0 || offset > destination.length()) throw DownloadRangeException()
+      RandomAccessFile(destination, "rw").use { it.setLength(offset) }
+    } else {
+      FileOutputStream(destination, false).use { }
+    }
+  } else if (append && destination.length() != offset) {
+    throw DownloadRangeException()
+  }
+  var written = start
+  body.byteStream().buffered().use { input ->
+    destination.outputStream(append).use { output ->
+      val buffer = ByteArray(8192)
+      while (true) {
+        if (stopped()) return null
+        val count = input.read(buffer)
+        if (count == -1) break
+        if (stopped()) return null
+        if (total >= 0 && count.toLong() > total - written) throw DownloadRangeException()
+        output.write(buffer, 0, count)
+        written += count
+        progress(written, total)
+      }
+    }
+  }
+  if (total >= 0 && written != total) throw IOException("Download ended before the expected length")
+  written
+}
