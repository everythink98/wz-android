+package com.reactnativepagerview
+
+import androidx.compose.foundation.gestures.ScrollScope
+import androidx.compose.foundation.gestures.TargetedFlingBehavior
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class TargetPageFlingBehaviorTest {
+  @Test
+  fun `emits the resolved fling target once after the delegate settles`() = runBlocking {
+    var targetPage = 1
+    var delegateSettled = false
+    var emittedBeforeDelegateSettled = false
+    val selectedPages = mutableListOf<Int>()
+    val delegate = object : TargetedFlingBehavior {
+      override suspend fun ScrollScope.performFling(
+        initialVelocity: Float,
+        onRemainingDistanceUpdated: (Float) -> Unit
+      ): Float {
+        onRemainingDistanceUpdated(0f)
+        onRemainingDistanceUpdated(900f)
+        onRemainingDistanceUpdated(450f)
+        delegateSettled = true
+        return 7f
+      }
+    }
+    val behavior = TargetPageFlingBehavior(
+      delegate = delegate,
+      settledPage = { 0 },
+      targetPage = { targetPage },
+      onTargetResolved = {
+        emittedBeforeDelegateSettled = !delegateSettled
+        selectedPages += it
+      }
+    )
+
+    val remainingVelocity = with(behavior) {
+      TestScrollScope.performFling(12f) { distance ->
+        targetPage = if (distance >= 0f) 1 else 0
+      }
+    }
+
+    assertEquals(listOf(1), selectedPages)
+    assertEquals(false, emittedBeforeDelegateSettled)
+    assertEquals(7f, remainingVelocity)
+  }
+
+  @Test
+  fun `emits only the final target after reversing direction`() = runBlocking {
+    var targetPage = 2
+    var targetUpdates = 0
+    val selectedPages = mutableListOf<Int>()
+    val delegate = object : TargetedFlingBehavior {
+      override suspend fun ScrollScope.performFling(
+        initialVelocity: Float,
+        onRemainingDistanceUpdated: (Float) -> Unit
+      ): Float {
+        onRemainingDistanceUpdated(0f)
+        onRemainingDistanceUpdated(200f)
+        onRemainingDistanceUpdated(-200f)
+        return 0f
+      }
+    }
+    val behavior = TargetPageFlingBehavior(
+      delegate = delegate,
+      settledPage = { 2 },
+      targetPage = { targetPage },
+      onTargetResolved = { selectedPages += it }
+    )
+
+    with(behavior) {
+      TestScrollScope.performFling(0f) {
+        targetUpdates += 1
+        targetPage = when (targetUpdates) {
+          2 -> 3
+          3 -> 1
+          else -> 2
+        }
+      }
+    }
+
+    assertEquals(listOf(1), selectedPages)
+  }
+
+  @Test
+  fun `does not emit when the final fling target returns to the starting page`() = runBlocking {
+    var targetPage = 3
+    var targetUpdates = 0
+    val selectedPages = mutableListOf<Int>()
+    val delegate = object : TargetedFlingBehavior {
+      override suspend fun ScrollScope.performFling(
+        initialVelocity: Float,
+        onRemainingDistanceUpdated: (Float) -> Unit
+      ): Float {
+        onRemainingDistanceUpdated(0f)
+        onRemainingDistanceUpdated(200f)
+        onRemainingDistanceUpdated(0f)
+        return 0f
+      }
+    }
+    val behavior = TargetPageFlingBehavior(
+      delegate = delegate,
+      settledPage = { 2 },
+      targetPage = { targetPage },
+      onTargetResolved = { selectedPages += it }
+    )
+
+    with(behavior) {
+      TestScrollScope.performFling(0f) {
+        targetUpdates += 1
+        targetPage = if (targetUpdates == 2) 3 else 2
+      }
+    }
+
+    assertEquals(emptyList<Int>(), selectedPages)
+  }
+
+  @Test
+  fun `does not emit when the delegate is canceled`() = runBlocking {
+    var targetPage = 2
+    var targetUpdates = 0
+    val selectedPages = mutableListOf<Int>()
+    val delegate = object : TargetedFlingBehavior {
+      override suspend fun ScrollScope.performFling(
+        initialVelocity: Float,
+        onRemainingDistanceUpdated: (Float) -> Unit
+      ): Float {
+        onRemainingDistanceUpdated(0f)
+        onRemainingDistanceUpdated(200f)
+        throw CancellationException("gesture canceled")
+      }
+    }
+    val behavior = TargetPageFlingBehavior(
+      delegate = delegate,
+      settledPage = { 2 },
+      targetPage = { targetPage },
+      onTargetResolved = { selectedPages += it }
+    )
+
+    try {
+      with(behavior) {
+        TestScrollScope.performFling(0f) {
+          targetUpdates += 1
+          targetPage = if (targetUpdates == 2) 3 else 2
+        }
+      }
+      throw AssertionError("expected cancellation")
+    } catch (_: CancellationException) {
+      // Expected: cancellation must escape without committing an intermediate page.
+    }
+
+    assertEquals(emptyList<Int>(), selectedPages)
+  }
+
+  private object TestScrollScope : ScrollScope {
+    override fun scrollBy(pixels: Float) = pixels
+  }
+}
