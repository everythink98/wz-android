+internal class TargetPageFlingBehavior(
+  private val delegate: TargetedFlingBehavior,
+  private val settledPage: () -> Int,
+  private val targetPage: () -> Int,
+  private val onTargetResolved: (Int) -> Unit
+) : TargetedFlingBehavior {
+  override suspend fun ScrollScope.performFling(
+    initialVelocity: Float,
+    onRemainingDistanceUpdated: (Float) -> Unit
+  ): Float {
+    val startPage = settledPage()
+    var receivedInitialDistance = false
+    var resolvedTarget = startPage
+    val remainingVelocity = with(delegate) {
+      performFling(initialVelocity) { remainingDistance ->
+        onRemainingDistanceUpdated(remainingDistance)
+        if (receivedInitialDistance) resolvedTarget = targetPage()
+        receivedInitialDistance = true
+      }
+    }
+    if (resolvedTarget != startPage) onTargetResolved(resolvedTarget)
+    return remainingVelocity
+  }
+}
