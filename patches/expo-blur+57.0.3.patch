+        assertEquals(View.VISIBLE, view.visibility)
+      }
+    }
+  }
+
+  @Test
+  @Config(sdk = [29], manifest = Config.NONE)
+  fun theGeneralBlurMethodStillConfiguresItsOlderApiRenderer() {
+    mockConstruction(RenderScriptBlur::class.java).use { renderer ->
+      withFixture { view, _, _ ->
+        view.setBlurMethod(BlurMethod.DIMEZIS_BLUR_VIEW)
+        view.setBlurTargetId(1)
+        view.setBlurTargetId(2)
+        assertEquals(2, renderer.constructed().size)
+      }
+    }
+  }
+
+  @Test
+  fun disjointViewportDrawsTintWithoutDrawingTheFullTarget() = withFixture { view, host, targets ->
+    view.setBlurMethod(BlurMethod.DIMEZIS_VIEWPORT)
+    view.setBlurTargetId(1)
+    view.setBlurRadius(8f)
+    val exact = View.MeasureSpec.makeMeasureSpec(1000, View.MeasureSpec.EXACTLY)
+    host.measure(exact, exact)
+    host.layout(0, 0, 1000, 1000)
+    view.offsetLeftAndRight(500)
+    val target = targets.first()
+    target.layout(0, 0, 80, 80)
+    val node = mock(RenderNode::class.java)
+    `when`(node.hasDisplayList()).thenReturn(true)
+    BlurTarget::class.java.getDeclaredField("renderNode").apply {
