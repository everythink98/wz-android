+    // Count attempted renderer construction without requiring Robolectric to load a RenderScript driver.
+    mockConstruction(RenderScriptBlur::class.java).use { renderer ->
+      withFixture { view, host, targets ->
+        view.setBlurMethod(BlurMethod.DIMEZIS_BLUR_VIEW_SDK_31_PLUS)
