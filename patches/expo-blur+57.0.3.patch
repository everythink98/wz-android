+    inner.setOverlayColor(tint)
+    val canvas = mock(Canvas::class.java)
+    `when`(canvas.isHardwareAccelerated).thenReturn(true)
+
+    inner.draw(canvas)
+    verify(canvas, times(0)).drawRenderNode(any(RenderNode::class.java))
+    verify(canvas).drawColor(tint)
+  }
+
+  @Test
+  fun targetChangesKeepTheActualHardwareDrawPath() = withFixture { view, _, _ ->
+    view.setBlurMethod(BlurMethod.DIMEZIS_BLUR_VIEW_SDK_31_PLUS)
+    view.setBlurTargetId(1)
+    val inner = view.getChildAt(0) as BlurView
+    val exact = View.MeasureSpec.makeMeasureSpec(40, View.MeasureSpec.EXACTLY)
+    inner.measure(exact, exact)
+    inner.layout(0, 0, 40, 40)
+    val canvas = mock(Canvas::class.java)
+    `when`(canvas.isHardwareAccelerated).thenReturn(true)
+    inner.draw(canvas)
+    view.setBlurTargetId(2)
+    inner.draw(canvas)
+    verify(canvas, times(2)).drawRenderNode(any(RenderNode::class.java))
