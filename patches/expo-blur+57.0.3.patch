+package eightbitlab.com.blurview
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.RenderEffect
+import android.graphics.RenderNode
+import android.graphics.Shader
+import android.graphics.drawable.Drawable
+import androidx.annotation.RequiresApi
+import kotlin.math.ceil
+
+open class ViewportBlurView(context: Context) : BlurView(context) {
+  @RequiresApi(31)
+  fun setupViewport(target: BlurTarget): BlurViewFacade {
+    blurController.destroy()
+    return ViewportBlurController(this, target).also { blurController = it }
+  }
+}
+
+@RequiresApi(31)
+private class ViewportBlurController(
+  private val view: BlurView,
+  private val target: BlurTarget,
+) : RenderNodeBlurController(view, target, Color.TRANSPARENT, BlurController.DEFAULT_SCALE_FACTOR, true) {
+  private val viewport = RenderNode("Blur viewport")
+  private val targetLocation = IntArray(2)
+  private val viewLocation = IntArray(2)
+  private var clearDrawable: Drawable? = null
+  private var tint = Color.TRANSPARENT
+  private var outset = 0
+  private var enabled = true
+
+  override fun setFrameClearDrawable(drawable: Drawable?): BlurViewFacade {
+    clearDrawable = drawable
+    return super.setFrameClearDrawable(drawable)
+  }
+
+  override fun setOverlayColor(color: Int): BlurViewFacade {
+    tint = color
+    return super.setOverlayColor(color)
+  }
+
+  override fun setBlurEnabled(enabled: Boolean): BlurViewFacade {
+    this.enabled = enabled
+    return super.setBlurEnabled(enabled)
+  }
+
+  override fun setBlurRadius(radius: Float): BlurViewFacade {
+    val pixels = radius * BlurController.DEFAULT_SCALE_FACTOR
+    // Keep the filter's kernel around the visible region and clamp at the real target edges.
+    outset = ceil(pixels * 3).toInt()
+    viewport.setRenderEffect(RenderEffect.createBlurEffect(pixels, pixels, Shader.TileMode.CLAMP))
+    return super.setBlurRadius(radius)
+  }
+
+  override fun draw(canvas: Canvas): Boolean {
+    if (!enabled) return true
+    if (!canvas.isHardwareAccelerated) return super.draw(canvas)
+    val source = target.renderNode
+    if (!source.hasDisplayList() || target.width == 0 || target.height == 0 || view.width == 0 || view.height == 0)
+      return super.draw(canvas)
+
+    target.getLocationOnScreen(targetLocation)
+    view.getLocationOnScreen(viewLocation)
+    val x = viewLocation[0] - targetLocation[0]
+    val y = viewLocation[1] - targetLocation[1]
+    val left = maxOf(x - outset, 0)
+    val top = maxOf(y - outset, 0)
+    val right = minOf(x + view.width + outset, target.width)
+    val bottom = minOf(y + view.height + outset, target.height)
+    val save = canvas.save()
+    canvas.clipRect(0, 0, view.width, view.height)
+    if (right > left && bottom > top) {
+      viewport.setPosition(left - x, top - y, right - x, bottom - y)
+      val recording = viewport.beginRecording()
+      recording.translate(-left.toFloat(), -top.toFloat())
+      clearDrawable?.draw(recording)
+      recording.drawRenderNode(source)
+      viewport.endRecording()
+      canvas.drawRenderNode(viewport)
+    }
+    Noise.apply(canvas, view.context, view.width, view.height)
+    if (tint != Color.TRANSPARENT) canvas.drawColor(tint)
+    canvas.restoreToCount(save)
+    return true
+  }
+
+  override fun destroy() {
+    viewport.discardDisplayList()
+    super.destroy()
+  }
+}
