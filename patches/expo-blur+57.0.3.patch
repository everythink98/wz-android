+package expo.modules.blur
+
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.view.View
+import android.view.ViewGroup
+import expo.modules.kotlin.AppContext
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mockito.Mockito.mock
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28, 35], manifest = Config.NONE)
+class ExpoBlurTargetViewTest {
+  @Test
+  fun removedContentStaysDrawnUntilTheRemovalTransitionEnds() {
+    val context = RuntimeEnvironment.getApplication()
+    val target = ExpoBlurTargetView(context, mock(AppContext::class.java))
+    var draws = 0
+    val child = object : View(context) {
+      init {
+        setWillNotDraw(false)
+      }
+      override fun onDraw(canvas: Canvas) {
+        draws += 1
+      }
+    }
+    target.addView(child, ViewGroup.LayoutParams(80, 80))
+    val exact = View.MeasureSpec.makeMeasureSpec(80, View.MeasureSpec.EXACTLY)
+    target.measure(exact, exact)
+    target.layout(0, 0, 80, 80)
+    child.measure(exact, exact)
+    child.layout(0, 0, 80, 80)
+    val bitmap = Bitmap.createBitmap(80, 80, Bitmap.Config.ARGB_8888)
+    val canvas = Canvas(bitmap)
+    target.draw(canvas)
+    assertTrue("The child must be drawable before removal", draws > 0)
+    target.startViewTransition(child)
+    target.removeView(child)
+    assertEquals(0, target.childCount)
+    val beforeTransitionDraw = draws
+    target.draw(canvas)
+    assertTrue("The outgoing content must stay drawn during the native pop animation", draws > beforeTransitionDraw)
+    target.endViewTransition(child)
+    val afterTransitionDraw = draws
+    target.draw(canvas)
+    assertEquals("Ending the transition must release the removed content", afterTransitionDraw, draws)
+    bitmap.recycle()
+  }
+}
