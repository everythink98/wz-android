{
  "expo": {
    "name": "阅坛 Android",
    "slug": "wz-android",
    "version": "1.3.139",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "platforms": ["android"],
    "userInterfaceStyle": "light",
    "extra": {
      "releaseSignerSha256": "6cb2f2a6034e18b7b82315e46e515b909817b9a211ee0f02c3c39224ef5bdd66"
    },
    "android": {
      "package": "com.wz.reader",
      "versionCode": 143,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "buildReactNativeFromSource": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-dev-client",
        {
          "toolsButton": false
        }
      ],
      "./plugins/withAndroidGradleJvmMemory",
      "./plugins/withApkInstaller",
      "./plugins/withForumSearchCustomTab",
      "./plugins/withSecureRandomModule",
      "./plugins/withNotificationDigestModule",
      "./plugins/withNetworkProxyModule",
      "./plugins/withPreviewRegionImageNative",
      "./plugins/withSvgRendererModule",
      [
        "expo-media-library",
        {
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1677FF",
          "defaultChannel": "message-notifications"
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
