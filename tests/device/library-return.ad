context platform=android
context timeout=180000
context retries=0
env APP_ID=com.wz.reader

open ${APP_ID} --relaunch
wait id="main-tab-library" 60000
press id="main-tab-library"
wait id="library-favorites-ready" 60000
wait "id=\"library-tab-favorites\" label=\"帖子，已选择\"" 10000
wait "id=\"library-source-all\" label=\"全部，已选择\"" 10000
press id="library-source-v2ex"
wait "id=\"library-source-v2ex\" label=\"V2EX，已选择\"" 10000
press id="library-source-all"
wait "id=\"library-source-all\" label=\"全部，已选择\"" 10000
press id="library-tab-users"
wait id="library-users-ready" 10000
wait "id=\"library-tab-users\" label=\"关注用户，已选择\"" 10000
wait "id=\"library-source-all\" label=\"全部，已选择\"" 10000
press id="library-source-v2ex"
wait "id=\"library-source-v2ex\" label=\"V2EX，已选择\"" 10000
press id="library-source-all"
wait "id=\"library-source-all\" label=\"全部，已选择\"" 10000
press id="library-tab-history"
wait id="library-history-ready" 10000
wait "id=\"library-tab-history\" label=\"历史，已选择\"" 10000
wait "id=\"library-source-all\" label=\"全部，已选择\"" 10000
press id="library-source-linuxdo"
wait "id=\"library-source-linuxdo\" label=\"linux.do，已选择\"" 10000
press id="library-source-all"
wait "id=\"library-source-all\" label=\"全部，已选择\"" 10000
