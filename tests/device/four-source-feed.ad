context platform=android
context timeout=180000
context retries=0
env APP_ID=com.wz.reader

open ${APP_ID} --relaunch
wait id="feed-list-ready-all" 60000
wait id="feed-topic-first" 10000
wait "id=\"feed-source-all\" label=\"全部，已选择\"" 10000
press id="feed-topic-first"
wait id="topic-detail-loaded" 60000
back --system
wait id="feed-list-ready-all" 60000
wait id="feed-topic-first" 10000
wait "id=\"feed-source-all\" label=\"全部，已选择\"" 10000
press id="feed-source-v2ex"
wait "id=\"feed-source-v2ex\" label=\"V2EX，已选择\"" 10000
wait id="feed-list-ready-v2ex" 60000
press label="列表筛选"
press text="最新"
wait id="feed-list-ready-v2ex" 60000
wait id="feed-topic-first" 10000
press id="feed-topic-first"
wait id="topic-detail-loaded" 60000
back --system
wait id="feed-list-ready-v2ex" 60000
wait id="feed-topic-first" 10000
wait "id=\"feed-source-v2ex\" label=\"V2EX，已选择\"" 10000
press id="feed-source-linuxdo"
wait "id=\"feed-source-linuxdo\" label=\"linux.do，已选择\"" 10000
wait id="feed-list-ready-linuxdo" 60000
press label="列表筛选"
press text="热门"
wait id="feed-list-ready-linuxdo" 60000
wait id="feed-topic-first" 10000
press id="feed-topic-first"
wait id="topic-detail-loaded" 60000
back --system
wait id="feed-list-ready-linuxdo" 60000
wait id="feed-topic-first" 10000
wait "id=\"feed-source-linuxdo\" label=\"linux.do，已选择\"" 10000
press id="feed-source-nodeseek"
wait "id=\"feed-source-nodeseek\" label=\"NodeSeek，已选择\"" 10000
wait id="feed-list-ready-nodeseek" 60000
press label="列表筛选"
press text="新评论"
wait id="feed-list-ready-nodeseek" 60000
wait id="feed-topic-first" 10000
press id="feed-topic-first"
wait id="topic-detail-loaded" 60000
back --system
wait id="feed-list-ready-nodeseek" 60000
wait id="feed-topic-first" 10000
wait "id=\"feed-source-nodeseek\" label=\"NodeSeek，已选择\"" 10000
press id="feed-source-yaohuo"
wait "id=\"feed-source-yaohuo\" label=\"妖火，已选择\"" 10000
wait id="feed-list-ready-yaohuo" 60000
wait id="feed-topic-first" 10000
press id="feed-topic-first"
wait id="topic-detail-loaded" 60000
back --system
wait id="feed-list-ready-yaohuo" 60000
wait id="feed-topic-first" 10000
wait "id=\"feed-source-yaohuo\" label=\"妖火，已选择\"" 10000
close
