context platform=android
context timeout=240000
context retries=0
env APP_ID=com.wz.reader

open ${APP_ID} --relaunch
wait id="main-tab-feed" 60000
wait "id=\"feed-source-all\" label=\"全部，已选择\"" 10000
wait id="feed-source-v2ex" 10000
wait id="feed-source-linuxdo" 10000
wait id="feed-source-nodeseek" 10000
wait id="feed-source-yaohuo" 10000
wait id="feed-source-xiaoyinsi" 10000
wait "id=\"feed-outcome-data-all-default\" || id=\"feed-outcome-empty-all-default\" || id=\"feed-outcome-partial-all-default\" || id=\"feed-outcome-error-all-default\" || id=\"feed-outcome-auth-all-default\"" 60000

press id="feed-source-v2ex"
wait "id=\"feed-source-v2ex\" label=\"V2EX，已选择\"" 10000
wait "id=\"feed-outcome-data-v2ex-all\" || id=\"feed-outcome-empty-v2ex-all\" || id=\"feed-outcome-partial-v2ex-all\" || id=\"feed-outcome-error-v2ex-all\" || id=\"feed-outcome-auth-v2ex-all\"" 60000

press id="feed-source-all"
wait "id=\"feed-source-all\" label=\"全部，已选择\"" 10000
wait "id=\"feed-outcome-data-all-default\" || id=\"feed-outcome-empty-all-default\" || id=\"feed-outcome-partial-all-default\" || id=\"feed-outcome-error-all-default\" || id=\"feed-outcome-auth-all-default\"" 60000
