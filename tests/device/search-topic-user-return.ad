context platform=android
context timeout=180000
context retries=0
env APP_ID=com.wz.reader

open ${APP_ID} --relaunch
wait id="feed-list-ready-all" 60000
press id="main-tab-search"
wait id="search-query" 10000
press id="search-source-v2ex"
wait "id=\"search-source-v2ex\" label=\"V2EX，已选择\"" 10000
press label="打开搜索筛选，当前默认"
wait text="筛选" 10000
press text="按时间"
press label="确认筛选"
wait label="打开搜索筛选，当前按时间" 10000
fill id="search-query" codex
is text id="search-query" codex
press id="search-submit"
keyboard dismiss
wait id="search-result-first" 60000
is visible id="search-result-first"
press id="search-result-first"
wait id="topic-detail-loaded" 60000
press id="topic-author"
wait id="user-screen-loaded" 60000
wait id="user-topic-first" 60000
press id="user-topic-first"
wait id="topic-detail-loaded" 60000
back --system
wait id="user-screen-loaded" 60000
back --system
wait id="topic-detail-loaded" 60000
back --system
wait id="search-complete" 60000
is text id="search-query" codex
wait "id=\"search-source-v2ex\" label=\"V2EX，已选择\"" 10000
wait label="打开搜索筛选，当前按时间" 10000
