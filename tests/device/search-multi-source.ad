context platform=android
context timeout=240000
context retries=0
env APP_ID=com.wz.reader

open ${APP_ID} --relaunch
wait id="main-tab-search" 60000
press id="main-tab-search"
wait id="search-query" 10000
press id="search-source-all"
wait "id=\"search-source-all\" label=\"全部，已选择\"" 10000
fill id="search-query" AI
is text id="search-query" AI
press id="search-submit"
wait id="search-all-sources-settled" 60000

press label="清空搜索关键词"
wait "label=\"搜索最近记录 AI\"" 10000
press id="search-source-v2ex"
wait "id=\"search-source-v2ex\" label=\"V2EX，已选择\"" 10000
wait label="打开搜索筛选，当前默认" 10000
press label="打开搜索筛选，当前默认"
press id="search-filter-node"
wait id="search-filter-node-option-qna" 10000
press id="search-filter-node-option-qna"
wait label="清除节点" 10000
press id="search-filter-time"
wait id="search-filter-back" 10000
press id="search-filter-back"
press id="search-filter-node"
wait id="search-filter-all-nodes" 10000
press id="search-filter-all-nodes"
wait id="search-filter-node" 10000
wait "label=\"展开 V2EX 更多筛选\"" 10000
press "label=\"展开 V2EX 更多筛选\""
wait id="search-filter-input-v2ex-author" 10000
is editable id="search-filter-input-v2ex-author"
fill id="search-filter-input-v2ex-author" handfeel
wait "label=\"收起 V2EX 更多筛选\"" 10000
is text id="search-filter-input-v2ex-author" handfeel
wait id="search-filter-close" 10000
press id="search-filter-close"
wait label="打开搜索筛选，当前默认" 10000
press id="search-source-linuxdo"
wait "id=\"search-source-linuxdo\" label=\"linux.do，已选择\"" 10000
wait label="打开搜索筛选，当前默认" 10000
press id="search-source-nodeseek"
wait "id=\"search-source-nodeseek\" label=\"NodeSeek，已选择\"" 10000
wait label="打开搜索筛选，当前默认" 10000
press id="search-source-yaohuo"
wait "id=\"search-source-yaohuo\" label=\"妖火，已选择\"" 10000
wait label="打开搜索筛选，当前默认" 10000
