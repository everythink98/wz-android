context platform=android
context timeout=240000
context retries=0
env APP_ID=com.wz.reader

open ${APP_ID} --relaunch
wait id="main-tab-more" 60000
press id="main-tab-more"
wait text="关于阅坛" 10000
press label="展开账号中心"
wait "id=\"account-site-nodeseek\" label=\"NodeSeek，未登录，已选择\" || id=\"account-site-nodeseek\" label=\"NodeSeek，已验证，已选择\"" 60000
press id="account-site-linuxdo"
wait "id=\"account-site-linuxdo\" label=\"linux.do，匿名可用，已选择\"" 60000
press id="account-site-yaohuo"
wait "id=\"account-site-yaohuo\" label=\"妖火，未登录，已选择\"" 60000
press id="account-site-xiaoyinsi"
wait "id=\"account-site-xiaoyinsi\" label=\"小隐寺，未登录，已选择\"" 60000
press label="收起账号中心"

press id="main-tab-search"
wait id="search-query" 10000
press id="search-source-all"
wait "id=\"search-source-all\" label=\"全部，已选择\"" 10000
fill id="search-query" codex
press id="search-submit"
keyboard dismiss
wait "id=\"search-outcome-data-v2ex\" || id=\"search-outcome-empty-v2ex\" || id=\"search-outcome-partial-v2ex\" || id=\"search-outcome-error-v2ex\" || id=\"search-outcome-auth-v2ex\"" 60000
wait "id=\"search-outcome-data-linuxdo\" || id=\"search-outcome-empty-linuxdo\" || id=\"search-outcome-partial-linuxdo\" || id=\"search-outcome-error-linuxdo\" || id=\"search-outcome-auth-linuxdo\"" 60000
wait "id=\"search-outcome-data-nodeseek\" || id=\"search-outcome-empty-nodeseek\" || id=\"search-outcome-partial-nodeseek\" || id=\"search-outcome-error-nodeseek\" || id=\"search-outcome-auth-nodeseek\"" 60000
wait "id=\"search-outcome-data-yaohuo\" || id=\"search-outcome-empty-yaohuo\" || id=\"search-outcome-partial-yaohuo\" || id=\"search-outcome-error-yaohuo\" || id=\"search-outcome-auth-yaohuo\"" 60000
wait "id=\"search-outcome-data-xiaoyinsi\" || id=\"search-outcome-empty-xiaoyinsi\" || id=\"search-outcome-partial-xiaoyinsi\" || id=\"search-outcome-error-xiaoyinsi\" || id=\"search-outcome-auth-xiaoyinsi\"" 60000

press id="main-tab-feed"
wait "id=\"feed-outcome-data-all-default\" || id=\"feed-outcome-empty-all-default\" || id=\"feed-outcome-partial-all-default\" || id=\"feed-outcome-error-all-default\" || id=\"feed-outcome-auth-all-default\"" 60000

open ${APP_ID} --relaunch
wait id="main-tab-more" 60000
press id="main-tab-more"
wait text="关于阅坛" 10000
press label="展开账号中心"
wait "id=\"account-site-nodeseek\" label=\"NodeSeek，未登录，已选择\" || id=\"account-site-nodeseek\" label=\"NodeSeek，已验证，已选择\"" 60000
